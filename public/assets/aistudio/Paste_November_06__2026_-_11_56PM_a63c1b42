name: Android CI and Release APKs

on:
  pull_request:
    branches:
      - main
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: android-release-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Test and build unsigned release APKs
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Check out source
        uses: actions/checkout@v6

      - name: Set up Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: 'platform-tools platforms;android-36 build-tools;36.0.0'
          accept-android-sdk-licenses: true

      - name: Grant execute permissions for scripts
        shell: bash
        run: |
          chmod +x gradlew
          chmod +x scripts/*.sh scripts/lib/*.sh .github/scripts/*.sh .github/scripts/*.py 2>/dev/null || true

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v5

      - name: Check sound assets and translations
        shell: bash
        run: python3 .github/scripts/check_sound_and_string_consistency.py

      - name: Test release archive handling
        run: python3 -m unittest discover -s .github/scripts/tests -v

      - name: Run unit tests
        shell: bash
        run: |
          set -o pipefail
          ./gradlew --no-daemon --stacktrace --console=plain -Djava.awt.headless=true :app:testDebugUnitTest 2>&1 | tee "$RUNNER_TEMP/gradle-test.log"

      - name: Surface unit test failure details
        if: failure()
        shell: bash
        run: |
          log_file="$RUNNER_TEMP/gradle-test.log"
          if [[ -f "$log_file" ]]; then
            test_failures=""
            if [[ -f ".github/scripts/summarize_test_failures.py" ]]; then
              test_failures="$(python3 .github/scripts/summarize_test_failures.py || true)"
            fi
            diagnostics="$(grep -E '^(e: |w: |> Task .* FAILED)' "$log_file" | tail -n 25 || true)"
            if [[ -n "$test_failures" ]]; then
              details="$test_failures"
              if [[ -n "$diagnostics" ]]; then
                details="$(printf '%s\n\n%s' "$diagnostics" "$test_failures")"
              fi
            elif [[ -n "$diagnostics" ]]; then
              failure_line="$(grep -n -m 1 '^FAILURE: Build failed' "$log_file" | cut -d: -f1 || true)"
              if [[ -n "$failure_line" ]]; then
                failure_end=$((failure_line + 20))
                failure_details="$(sed -n "${failure_line},${failure_end}p" "$log_file")"
              else
                failure_details="$(tail -n 20 "$log_file")"
              fi
              details="$(printf '%s\n\n%s' "$diagnostics" "$failure_details")"
            else
              failure_line="$(grep -n -m 1 '^FAILURE: Build failed' "$log_file" | cut -d: -f1 || true)"
              if [[ -n "$failure_line" ]]; then
                failure_end=$((failure_line + 20))
                details="$(sed -n "${failure_line},${failure_end}p" "$log_file")"
              else
                details="$(tail -n 20 "$log_file")"
              fi
            fi
            details="${details:0:3500}"
            {
              echo '### Gradle unit test failure details'
              echo '```text'
              printf '%s\n' "$details"
              echo '```'
            } >> "$GITHUB_STEP_SUMMARY"
            details="${details//'%'/'%25'}"
            details="${details//$'\n'/'%0A'}"
            details="${details//$'\r'/'%0D'}"
            echo "::error file=.github/workflows/android.yml,line=51,title=Gradle unit tests failed::$details"
          fi

      - name: Assemble production release APKs
        shell: bash
        run: |
          set -o pipefail
          # Configure init script to build unsigned release APKs cleanly in CI environment
          init_script="$RUNNER_TEMP/disable-signing.gradle"
          cat << 'EOF' > "$init_script"
          allprojects {
              afterEvaluate { project ->
                  if (project.hasProperty('android')) {
                      project.android.buildTypes.release.signingConfig = null
                  }
              }
          }
          EOF
          ./gradlew --no-daemon --stacktrace --console=plain -I "$init_script" :app:assembleRelease 2>&1 | tee "$RUNNER_TEMP/gradle-release.log"

      - name: Surface release build failure details
        if: failure()
        shell: bash
        run: |
          log_file="$RUNNER_TEMP/gradle-release.log"
          if [[ -f "$log_file" ]]; then
            failure_line="$(grep -n -m 1 '^FAILURE: Build failed' "$log_file" | cut -d: -f1 || true)"
            diagnostics="$(grep -E '^(e: |w: |> Task .* FAILED)' "$log_file" | tail -n 12 || true)"
            if [[ -n "$failure_line" ]]; then
              failure_end=$((failure_line + 24))
              failure_details="$(sed -n "${failure_line},${failure_end}p" "$log_file")"
            else
              failure_details="$(tail -n 24 "$log_file")"
            fi
            details="$(printf '%s\n%s\n' "$diagnostics" "$failure_details")"
            details="${details:0:3500}"
            {
              echo '### Gradle release build failure details'
              echo '```text'
              printf '%s\n' "$details"
              echo '```'
            } >> "$GITHUB_STEP_SUMMARY"
            details="${details//'%'/'%25'}"
            details="${details//$'\n'/'%0A'}"
            details="${details//$'\r'/'%0D'}"
            echo "::error file=.github/workflows/android.yml,line=90,title=Gradle release build failed::$details"
          fi

      # ---------------------------------------------------------------------
      # Release packaging
      #
      # Two artifacts are produced on purpose:
      #
      #   open-fire-release.apk           signed, verified, directly installable
      #   open-fire-release-unsigned.apk  pristine unsigned package, for the
      #                                   Play Console / distributor signing
      #
      # Shipping only an unsigned APK was what produced "The package appears to
      # be invalid": an unsigned APK never installs, and the JAR-only signature
      # most tools add when signing it by hand is refused by Android 11+ for an
      # app that targets API 30+ (see docs/INSTALLING.md).
      # ---------------------------------------------------------------------

      - name: Prepare canonical release APKs
        shell: bash
        run: |
          set -euo pipefail

          output_dir="app/build/outputs/apk/release"
          artifact_dir="release-artifacts"

          if [[ ! -d "$output_dir" ]]; then
            echo "::error::Gradle did not create the release APK output directory: $output_dir"
            exit 1
          fi

          shopt -s nullglob
          apks=("$output_dir"/*.apk)
          if [[ ${#apks[@]} -eq 0 ]]; then
            echo "::error::No release APKs found in $output_dir"
            exit 1
          fi

          sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
          if [[ -z "$sdk_root" || ! -d "$sdk_root/build-tools" ]]; then
            echo "::error::Android SDK build-tools were not found"
            exit 1
          fi
          mapfile -t apksigners < <(find "$sdk_root/build-tools" -type f -name apksigner -print | sort -V)
          if [[ ${#apksigners[@]} -eq 0 ]]; then
            echo "::error::apksigner was not found in the Android SDK build-tools"
            exit 1
          fi
          apksigner="${apksigners[${#apksigners[@]}-1]}"

          mapfile -t zipaligns < <(find "$sdk_root/build-tools" -type f -name zipalign -print | sort -V)
          if [[ ${#zipaligns[@]} -eq 0 ]]; then
            echo "::error::zipalign was not found in the Android SDK build-tools"
            exit 1
          fi
          zipalign="${zipaligns[${#zipaligns[@]}-1]}"

          # Flat artifact directory so the ZIP holds the APKs directly.
          rm -rf "$artifact_dir"
          mkdir -p "$artifact_dir"
          prepared_apks=()
          for source_apk in "${apks[@]}"; do
            filename="$(basename "$source_apk")"
            if [[ "$filename" != *-unsigned.apk ]]; then
              echo "::error::Expected an unsigned APK filename, got $filename"
              exit 1
            fi

            # Check APK zip integrity
            unzip -tq "$source_apk"

            # The signing config must have been disabled for this build; an APK that
            # is already signed cannot be re-signed cleanly later.
            if "$apksigner" verify "$source_apk" >/dev/null 2>&1; then
              echo "::error::Expected an unsigned release APK, but $source_apk has a valid signature"
              exit 1
            fi

            destination_apk="$artifact_dir/${filename/app-/open-fire-}"
            cp "$source_apk" "$destination_apk"
            prepared_apks+=("$destination_apk")
            echo "Prepared unsigned APK: $destination_apk"
          done

          # shellcheck source=.github/scripts/ci-helpers.sh
          source .github/scripts/ci-helpers.sh

          # Canonicalize (one consistent set of ZIP headers, stored and aligned
          # sound assets, no Data Descriptors) BEFORE signing: rewriting the ZIP
          # after signing drops the APK Signing Block, which is the "invalid
          # package" failure on the device.
          run_annotated "canonicalize release APK" \
            python3 .github/scripts/prepare_release_archive.py normalize \
            --zipalign "$zipalign" \
            "${prepared_apks[@]}"

          for prepared_apk in "${prepared_apks[@]}"; do
            run_annotated "unzip -t $prepared_apk" unzip -tq "$prepared_apk"
            run_annotated "zipalign -c $prepared_apk" "$zipalign" -c 4 "$prepared_apk"
            if "$apksigner" verify "$prepared_apk" >/dev/null 2>&1; then
              echo "::error::Expected $prepared_apk to remain unsigned after alignment"
              exit 1
            fi
          done

      - name: Verify release APK
        shell: bash
        run: |
          set -euo pipefail

          # shellcheck source=.github/scripts/ci-helpers.sh
          source .github/scripts/ci-helpers.sh

          # The release artifact must stay unsigned, aligned and structurally valid.
          run_annotated "verify unsigned APK" \
            bash scripts/verify-installable-apk.sh release-artifacts/open-fire-release-unsigned.apk

          sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
          mapfile -t apksigners < <(find "$sdk_root/build-tools" -type f -name apksigner -print | sort -V)
          apksigner="${apksigners[${#apksigners[@]}-1]}"
          mapfile -t zipaligns < <(find "$sdk_root/build-tools" -type f -name zipalign -print | sort -V)
          zipalign="${zipaligns[${#zipaligns[@]}-1]}"

          if "$apksigner" verify release-artifacts/open-fire-release-unsigned.apk >/dev/null 2>&1; then
            echo "::error::open-fire-release-unsigned.apk must not be signed"
            exit 1
          fi

          for apk in release-artifacts/*.apk; do
            run_annotated "unzip -t $apk" unzip -tq "$apk"
            run_annotated "zipalign -c $apk" "$zipalign" -c 4 "$apk"
            run_annotated "java VerifyZipStreams $apk" \
              java .github/scripts/VerifyZipStreams.java "$apk"
          done

      - name: Round-trip the release APK through apksig
        shell: bash
        run: |
          set -euo pipefail

          # The reported failure
          #   W: Malformed ZIP entry: assets/sounds/medkit.mp3
          #   W: invalid stored block lengths
          # comes from apksig: it takes an entry's compression method and compressed
          # size from the Central Directory and inflates that byte range. Signing with
          # the JAR (v1) scheme forces apksig to inflate every entry, so a header that
          # disagrees with its payload breaks this step instead of the published
          # artifact. This step also exercises the documented signing flow
          # (scripts/sign-release-apk.sh with an explicit keystore) end to end.
          keystore="$RUNNER_TEMP/ci-signing.p12"
          rm -f "$keystore"
          keytool -genkeypair \
            -keystore "$keystore" \
            -storetype PKCS12 \
            -storepass android \
            -keypass android \
            -alias ci-release \
            -keyalg RSA \
            -keysize 2048 \
            -validity 1 \
            -dname "CN=Open Fire CI"

          # shellcheck source=.github/scripts/ci-helpers.sh
          source .github/scripts/ci-helpers.sh

          signed="$RUNNER_TEMP/open-fire-release-roundtrip.apk"
          rm -f "$signed"
          run_annotated "sign round-trip APK" \
            bash scripts/sign-release-apk.sh \
            release-artifacts/open-fire-release-unsigned.apk \
            --out "$signed" \
            --ks "$keystore" \
            --ks-type PKCS12 \
            --ks-alias ci-release \
            --ks-pass android \
            --key-pass android

          sdk_root="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
          mapfile -t apksigners < <(find "$sdk_root/build-tools" -type f -name apksigner -print | sort -V)
          apksigner="${apksigners[${#apksigners[@]}-1]}"

          # The v1 (JAR) signature must really exist: it is what forced apksig to
          # inflate every entry above.
          if ! unzip -l "$signed" | grep -Fq "META-INF/MANIFEST.MF"; then
            echo "::error::the signed APK has no JAR (v1) signature"
            exit 1
          fi

          # apksig only checks the JAR (v1) scheme for platforms below API 24, so
          # verify for API 23 as well; that makes apksig inflate and digest every
          # entry again.
          legacy_report="$( "$apksigner" verify --verbose --min-sdk-version 23 "$signed" )"
          printf '%s\n' "$legacy_report"
          if ! grep -Eq 'v1 scheme \(JAR signing\): true' <<< "$legacy_report"; then
            echo "::error::the signed APK does not verify with the JAR (v1) scheme for API 23"
            exit 1
          fi

          unzip -tq "$signed"
          java .github/scripts/VerifyZipStreams.java "$signed"
          rm -f "$signed"

      - name: Build the release ZIP
        shell: bash
        run: |
          set -euo pipefail

          archive_zip="release-artifacts/open-fire-release-apks.zip"
          shopt -s nullglob
          apks=(release-artifacts/*.apk)
          if [[ ${#apks[@]} -eq 0 ]]; then
            echo "::error::No release APKs to package"
            exit 1
          fi

          # shellcheck source=.github/scripts/ci-helpers.sh
          source .github/scripts/ci-helpers.sh

          # `package` verifies the APKs as they are (it never rewrites a signed
          # package) and stores them without recompression in a seekable ZIP.
          run_annotated "prepare_release_archive.py package" \
            python3 .github/scripts/prepare_release_archive.py package \
            --output "$archive_zip" \
            "${apks[@]}"

          run_annotated "unzip -t $archive_zip" unzip -tq "$archive_zip"
          run_annotated "java VerifyZipStreams $archive_zip" \
            java .github/scripts/VerifyZipStreams.java "$archive_zip" "${apks[@]}"

      - name: Publish release APK summary
        shell: bash
        run: |
          set -euo pipefail

          files=()
          archive="release-artifacts/open-fire-release-apks.zip"
          if [[ -f "$archive" ]]; then
            files+=("$archive")
          fi
          for apk in release-artifacts/*.apk; do
            if [[ -f "$apk" ]]; then
              files+=("$apk")
            fi
          done
          if [[ ${#files[@]} -eq 0 ]]; then
            echo "No release artifacts to summarize"
            exit 0
          fi

          {
            echo '### Open Fire Release APKs'
            echo
            echo 'Application ID: `com.blindtechnexus.openfire`'
            echo
            echo '| File | Purpose | Size | SHA-256 Checksum |'
            echo '| --- | --- | --- | --- |'
            for file in "${files[@]}"; do
              filename="$(basename "$file")"
              case "$filename" in
                open-fire-release-unsigned.apk) purpose='Unsigned release package for distribution / your signing key' ;;
                *) purpose='Release archive, stored without recompression' ;;
              esac
              size="$(du -h "$file" | cut -f1)"
              sha="$(sha256sum "$file" | cut -d' ' -f1)"
              printf '| `%s` | %s | %s | `%s` |\n' "$filename" "$purpose" "$size" "$sha"
            done
            echo
            echo 'Sign `open-fire-release-unsigned.apk` with your release key before installing:'
            echo
            echo '```sh'
            echo 'scripts/sign-release-apk.sh open-fire-release-unsigned.apk --out open-fire-release.apk --ks my-key.jks'
            echo 'adb install -r open-fire-release.apk'
            echo '```'
            echo
            echo 'If Android reports "The package appears to be invalid", run'
            echo '`scripts/verify-installable-apk.sh <file.apk>` to see exactly which check fails.'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload release APKs
        uses: actions/upload-artifact@v7
        with:
          name: open-fire-release-apks.zip
          path: release-artifacts/open-fire-release-apks.zip
          archive: false
          if-no-files-found: error
          retention-days: 30

      - name: Download uploaded release ZIP for verification
        uses: actions/download-artifact@v8
        with:
          name: open-fire-release-apks.zip
          path: verified-download
          skip-decompress: true
          digest-mismatch: error

      - name: Verify downloaded release ZIP integrity
        shell: bash
        run: |
          set -euo pipefail
          mapfile -t downloaded_files < <(find verified-download -maxdepth 1 -type f | sort)
          if [[ ${#downloaded_files[@]} -ne 1 ]]; then
            echo "::error::Expected exactly 1 downloaded artifact file, found ${#downloaded_files[@]}"
            exit 1
          fi
          downloaded_zip="${downloaded_files[0]}"
          expected_args=()
          for apk in release-artifacts/*.apk; do
            expected_args+=(--expected-apk "$apk")
          done
          cmp release-artifacts/open-fire-release-apks.zip "$downloaded_zip"
          unzip -tq "$downloaded_zip"
          python3 .github/scripts/prepare_release_archive.py verify "$downloaded_zip" "${expected_args[@]}"
          java .github/scripts/VerifyZipStreams.java "$downloaded_zip"

          # The bytes a user downloads must contain the same installable APK that was
          # verified above, so extract it again and re-check the signature.
          # shellcheck source=.github/scripts/ci-helpers.sh
          source .github/scripts/ci-helpers.sh

          rm -rf verified-download/extracted
          mkdir -p verified-download/extracted
          unzip -q "$downloaded_zip" -d verified-download/extracted
          run_annotated "verify downloaded unsigned release APK" \
            bash scripts/verify-installable-apk.sh \
            verified-download/extracted/open-fire-release-unsigned.apk
